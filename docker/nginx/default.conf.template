# Teacher Box SPA + API reverse proxy (split variant, ADR-0004).
# ${BACKEND_URL} is substituted by the nginx image entrypoint (envsubst) at container start.

map $http_x_forwarded_proto $teacherbox_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 30m;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $teacherbox_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        # AI requests and file uploads may take a while.
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        # nginx adds the security headers itself (server level); avoid duplicates from the backend.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Content-Security-Policy;
    }

    location = /actuator/health {
        proxy_pass ${BACKEND_URL};
    }

    # Other management endpoints are never exposed.
    location /actuator/ {
        return 404;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Hashed build artifacts never change.
    location ~* ^/(?:[^/]+\.(?:js|css)|media/.+)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Client-side routes fall back to index.html, which must always be revalidated.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
