# Teacher Box SPA + API reverse proxy (split variant, ADR-0004).
# ${BACKEND_URL} and ${LIVEKIT_URL} are substituted by the nginx image entrypoint (envsubst) at container start.

map $http_x_forwarded_proto $teacherbox_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# The live channel of a board is a WebSocket (ADR-0029): pass the upgrade on, keep other requests plain.
map $http_upgrade $teacherbox_connection {
    default upgrade;
    ""      "";
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 30m;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $teacherbox_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $teacherbox_connection;
        # AI requests and file uploads may take a while; an open board pings its channel every 30 s.
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        # nginx adds the security headers itself (server level); avoid duplicates from the backend.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Content-Security-Policy;

        # Textbooks take files up to 100 MB (ADR-0033); the headers above are inherited.
        location /api/teacher/textbooks {
            client_max_body_size 105m;
            proxy_pass ${BACKEND_URL};
        }
    }

    # Signalling of the built-in calls (ADR-0030): a WebSocket to LiveKit (profile "calls"). The name is
    # resolved per request, so nginx also starts without the LiveKit container (then this answers 502).
    location /livekit/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $teacherbox_livekit ${LIVEKIT_URL};
        rewrite ^/livekit/(.*)$ /$1 break;
        proxy_pass $teacherbox_livekit;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $teacherbox_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $teacherbox_connection;
        # A call keeps its channel open for hours; LiveKit pings it.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location = /actuator/health {
        proxy_pass ${BACKEND_URL};
    }

    # Other management endpoints are never exposed.
    location /actuator/ {
        return 404;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Style bundles loaded on demand by name (angular.json `inject: false`, ADR-0028) are not hashed.
    location = /excalidraw.css {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Hashed build artifacts never change.
    location ~* ^/(?:[^/]+\.(?:js|css)|media/.+)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Client-side routes fall back to index.html, which must always be revalidated.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
