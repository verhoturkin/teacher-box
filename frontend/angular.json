{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": [
      "angular-eslint"
    ]
  },
  "newProjectRoot": "projects",
  "projects": {
    "teacher-box": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "tb",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*.woff2",
                "input": "node_modules/@excalidraw/excalidraw/dist/prod/fonts",
                "output": "excalidraw-assets/fonts"
              }
            ],
            "styles": [
              "src/styles.scss",
              {
                "input": "node_modules/@fullcalendar/angular/skeleton.css",
                "bundleName": "calendar",
                "inject": false
              },
              {
                "input": "node_modules/@fullcalendar/angular/themes/classic/theme.css",
                "bundleName": "calendar",
                "inject": false
              },
              {
                "input": "src/app/features/schedule/ui/schedule-calendar.scss",
                "bundleName": "calendar",
                "inject": false
              },
              {
                "input": "src/app/features/boards/editor/excalidraw-theme.scss",
                "bundleName": "excalidraw",
                "inject": false
              },
              {
                "input": "node_modules/@excalidraw/excalidraw/dist/prod/index.css",
                "bundleName": "excalidraw",
                "inject": false
              }
            ]
          },
          "configurations": {
            "production": {
              "serviceWorker": "ngsw-config.json",
              "fileReplacements": [
                {
                  "replace": "src/app/features/gallery/dev-routes.ts",
                  "with": "src/app/features/gallery/dev-routes.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1.2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "teacher-box:build:production"
            },
            "development": {
              "buildTarget": "teacher-box:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runnerConfig": "vitest.config.ts",
            "coverageReporters": [
              "text-summary",
              "html",
              "lcovonly"
            ],
            "coverageInclude": [
              "src/app/**/*.ts"
            ],
            "coverageExclude": [
              "src/app/**/*.spec.ts",
              "src/app/**/index.ts",
              "src/app/**/*.models.ts",
              "src/app/features/gallery/*/*.ts"
            ],
            "coverageThresholds": {
              "statements": 90,
              "branches": 80,
              "functions": 90,
              "lines": 90
            },
            "setupFiles": [
              "src/test-setup.ts"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  }
}
