{
  "permissions": {
    "deny": [
      "Read(**/package-lock.json)",
      "Read(**/node_modules/**)",
      "Read(frontend/dist/**)",
      "Read(frontend/.angular/**)",
      "Read(frontend/coverage/**/*.html)",
      "Read(backend/target/classes/**)",
      "Read(backend/target/test-classes/**)",
      "Read(backend/target/site/**/*.html)",
      "Read(backend/data/**)",
      "Read(e2e/test-results/**)"
    ],
    "allow": [
      "Bash(./mvnw:*)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:only:*)",
      "Bash(npm run build:*)",
      "Bash(./scripts/verify.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
