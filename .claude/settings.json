{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "MAX_MCP_OUTPUT_TOKENS": "15000"
  },
  "permissions": {
    "deny": [
      "Read(**/package-lock.json)",
      "Read(**/node_modules/**)",
      "Read(frontend/dist/**)",
      "Read(frontend/.angular/**)",
      "Read(frontend/coverage/**/*.html)",
      "Read(backend/target/classes/**)",
      "Read(backend/target/test-classes/**)",
      "Read(backend/target/site/**/*.html)",
      "Read(backend/data/**)",
      "Read(e2e/test-results/**)",
      "Read(frontend/src/testing/help-articles.fixture.json)",
      "Read(docs/assets/**)"
    ],
    "allow": [
      "Bash(./mvnw:*)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:only:*)",
      "Bash(npm run build:*)",
      "Bash(./scripts/verify.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/big-read.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
