# Teacher Box settings. Copy to .env and adjust: cp .env.example .env
# Every variable is optional unless stated otherwise.

# --- Deployment ---------------------------------------------------------------
# Host port of the web interface.
TEACHERBOX_HTTP_PORT=8080
# Image tag used by docker compose.
TEACHERBOX_VERSION=latest

# --- Instance --------------------------------------------------------------------
# Time zone of the teacher: lesson dates and monthly reports use it.
TEACHERBOX_TIMEZONE=Europe/Moscow

# --- Billing ---------------------------------------------------------------------
# Currency of all amounts (ISO 4217).
TEACHERBOX_BILLING_CURRENCY=RUB
# Lesson price of a new student, in currency units (can be changed per student later).
TEACHERBOX_BILLING_DEFAULT_LESSON_PRICE=0
# Default lesson duration in minutes.
TEACHERBOX_BILLING_DEFAULT_LESSON_DURATION=60

# --- Homework ----------------------------------------------------------------------
# Maximum size of one attached file (the HTTP limit is 25MB per file / 30MB per request).
TEACHERBOX_HOMEWORK_MAX_FILE_SIZE=20MB
TEACHERBOX_HOMEWORK_MAX_FILES_PER_UPLOAD=10
# Students get a reminder this long before the deadline.
TEACHERBOX_HOMEWORK_DUE_SOON_WINDOW=24h

# --- Schedule ------------------------------------------------------------------
# Duration of a lesson when none is given, in minutes.
# TEACHERBOX_SCHEDULE_DEFAULT_DURATION=60
# How far ahead the lessons of regular series are created.
# TEACHERBOX_SCHEDULE_HORIZON=84d
# A student's cancellation later than this before the lesson is "late": the teacher decides
# whether to charge it as a missed lesson.
TEACHERBOX_SCHEDULE_LATE_CANCELLATION=24h
# Reminders before a lesson (comma-separated; empty = none). The teacher gets only the last one.
TEACHERBOX_SCHEDULE_REMINDERS=24h,1h

# --- Notifications -------------------------------------------------------------
# Public address of the portal: messenger messages link to it (e.g. https://school.example.com).
TEACHERBOX_PUBLIC_URL=
# Messengers are enabled by their tokens; bots use long polling, no public webhook is needed.
# Telegram: create a bot with @BotFather and paste its token.
TEACHERBOX_NOTIFICATIONS_TELEGRAM_BOT_TOKEN=
# Proxy for Telegram when it is blocked from the server's network: http://host:port or
# socks5://host:port (no login/password). A proxy on the Docker host is host.docker.internal,
# e.g. socks5://host.docker.internal:1080. VK and MAX are always reached directly.
TEACHERBOX_NOTIFICATIONS_TELEGRAM_PROXY=
# Alternative Bot API address (a self-hosted Bot API server or your own reverse proxy abroad).
# TEACHERBOX_NOTIFICATIONS_TELEGRAM_API_URL=https://api.telegram.org
# VK: community settings -> API: access token with the "messages" permission; enable community
# messages and Bots Long Poll API (event "incoming message"). Group id is the number from club<id>.
TEACHERBOX_NOTIFICATIONS_VK_TOKEN=
TEACHERBOX_NOTIFICATIONS_VK_GROUP_ID=
# MAX: token of a bot from the MAX platform for partners.
TEACHERBOX_NOTIFICATIONS_MAX_TOKEN=
# TEACHERBOX_NOTIFICATIONS_MAX_ATTEMPTS=8
# TEACHERBOX_NOTIFICATIONS_LINK_CODE_TTL=15m

# --- AI assistant (drafts of homework and reviews; teacher only) ---------------
# Empty: AI features are hidden. "anthropic" (Claude), "gemini" (Gemini API key from
# Google AI Studio; a Google AI Pro subscription cannot be used) or "openai-compatible"
# (OpenAI, OpenRouter, Ollama, LM Studio, vLLM, ...).
TEACHERBOX_AI_PROVIDER=
TEACHERBOX_AI_API_KEY=
# Anthropic: defaults to claude-opus-5. Gemini: defaults to gemini-3.8-flash.
# OpenAI-compatible: required (e.g. gpt-5, qwen3:14b).
TEACHERBOX_AI_MODEL=
# Anthropic and Gemini: optional alternative API address. OpenAI-compatible: required, e.g.
# https://api.openai.com/v1, https://openrouter.ai/api/v1, http://ollama:11434/v1
TEACHERBOX_AI_BASE_URL=
# Input + output tokens per calendar month; 0 = no limit.
TEACHERBOX_AI_MONTHLY_TOKEN_LIMIT=2000000
# Proxy for the AI provider (the Anthropic, OpenAI and Gemini APIs are not available from
# Russia): http://host:port or socks5://host:port, no login/password.
TEACHERBOX_AI_PROXY=
# Anthropic only: effort (low, medium, high, xhigh, max; empty = model default) and
# server-side fallback to another model when a request is declined.
# TEACHERBOX_AI_EFFORT=
# TEACHERBOX_AI_FALLBACKS=true
# TEACHERBOX_AI_MAX_TOKENS=16000
# TEACHERBOX_AI_TIMEOUT=120s

# --- Teacher account (created on first start) ----------------------------------
TEACHERBOX_IDENTITY_TEACHER_LOGIN=teacher
# At least 8 characters. Empty: a random password is generated and printed to the log once
# (docker compose logs | grep "Teacher account").
TEACHERBOX_IDENTITY_TEACHER_PASSWORD=
TEACHERBOX_IDENTITY_TEACHER_NAME=Учитель
# Account recovery: set to true together with a new TEACHERBOX_IDENTITY_TEACHER_PASSWORD,
# restart once, then set back to false.
TEACHERBOX_IDENTITY_TEACHER_RESET_PASSWORD=false

# --- Sessions -------------------------------------------------------------------
# TEACHERBOX_IDENTITY_ACCESS_TOKEN_TTL=15m
# TEACHERBOX_IDENTITY_REFRESH_TOKEN_TTL=30d
# TEACHERBOX_IDENTITY_INVITE_TTL=7d
# TEACHERBOX_IDENTITY_MAX_FAILED_LOGINS=5
# TEACHERBOX_IDENTITY_LOCK_DURATION=15m

# --- Security -----------------------------------------------------------------
# HMAC secret for access tokens, at least 32 characters.
# Empty: a random key is generated on first start and kept in the data volume (/data/keys).
TEACHERBOX_SECURITY_JWT_SECRET=

# Sign-in, refresh and invitation requests per client address and period (0 = no limit).
# TEACHERBOX_SECURITY_AUTH_RATE_LIMIT_REQUESTS=30
# TEACHERBOX_SECURITY_AUTH_RATE_LIMIT_PERIOD=1m

# --- Backups -------------------------------------------------------------------
# Automatic backups of the database and files into /data/backups (instance time zone).
# Schedule in cron format (second minute hour day month weekday); "-" disables it.
TEACHERBOX_BACKUP_CRON=0 30 3 * * *
# How many backups to keep.
TEACHERBOX_BACKUP_KEEP=7
# To restore: put a backup .zip into /data/restore/ and restart (see docs/operations.md).

# --- Resources and logs --------------------------------------------------------
# Container limits (docker compose). The JVM uses 75% of the memory limit.
TEACHERBOX_MEMORY_LIMIT=1g
TEACHERBOX_CPU_LIMIT=2
# JSON logs for log collectors (ecs, logstash or gelf); plain text when not set.
# LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs

# --- JVM ------------------------------------------------------------------------
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
