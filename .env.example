# Teacher Box settings. Copy to .env and adjust: cp .env.example .env (scripts/install.sh does it for you).
# Only the "Main" block matters for a start; every other line is commented out and shows its default:
# remove the "# " and change the value to set it. What the teacher sets up (time zone, currency, lesson
# rules, messengers, Google) lives in the portal's Settings, the administrator's limits, proxies, sessions and
# backup schedule in the administrator's Settings, not here (ADR-0056). Variables of those settings that are
# still in this file keep working for the administrator's ones and are imported once for the teacher's.

# --- Main ---------------------------------------------------------------------
# Domain of the portal, e.g. school.example.com: with the profile "https" below the built-in Caddy gets the
# certificate itself (the domain points to this server, ports 80 and 443 are open), and the portal address
# becomes https://<domain>. Empty: the portal runs over plain HTTP on port 8080.
TEACHERBOX_DOMAIN=
# Optional parts, comma-separated: https (the Caddy container, needs the domain) and calls (built-in video
# calls, see "Video calls" below), e.g. https,calls.
COMPOSE_PROFILES=
# Password of the teacher, at least 8 characters. Empty: a random one is generated on the first start and
# printed to the log (docker compose logs backend | grep "Teacher account"); the portal asks to change it.
TEACHERBOX_IDENTITY_TEACHER_PASSWORD=

# --- Deployment ---------------------------------------------------------------
# Host port of the web interface. With the profile "https" publish it only on the loopback (127.0.0.1:8080),
# so that the portal is reachable from outside only through Caddy.
# TEACHERBOX_HTTP_PORT=8080
# Image tag used by docker compose.
# TEACHERBOX_VERSION=latest

# --- Video calls (LiveKit, ADR-0030) -------------------------------------------
# Built-in calls need the LiveKit container: add "calls" to COMPOSE_PROFILES and set the API key and
# secret (the secret is at least 32 characters, e.g. openssl rand -hex 24). Without them the portal
# works with external call links only. Open 7881/tcp, 7882/udp, 3478/udp, 30000-30049/udp.
# TEACHERBOX_MEETINGS_LIVEKIT_API_KEY=
# TEACHERBOX_MEETINGS_LIVEKIT_API_SECRET=
# Address of LiveKit for the portal itself; browsers always connect to <portal address>/livekit.
# TEACHERBOX_MEETINGS_LIVEKIT_API_URL=http://livekit:7880
# The public IP of the server for media is found through STUN. To give it yourself (a server behind
# NAT, or 127.0.0.1 for a check on your computer) set false and the address.
# TEACHERBOX_LIVEKIT_USE_EXTERNAL_IP=true
# TEACHERBOX_LIVEKIT_NODE_IP=
# Limits of the LiveKit container.
# TEACHERBOX_LIVEKIT_MEMORY_LIMIT=512m
# TEACHERBOX_LIVEKIT_CPU_LIMIT=2

# --- Teacher account (created on first start) ----------------------------------
# TEACHERBOX_IDENTITY_TEACHER_LOGIN=teacher
# Account recovery: set to true together with a new TEACHERBOX_IDENTITY_TEACHER_PASSWORD,
# restart once, then set back to false.
# TEACHERBOX_IDENTITY_TEACHER_RESET_PASSWORD=false

# Administrator (ADR-0010): a technical account for whoever helps with the server — the log, state,
# integrations and diagnostics, without access to students' data. Empty password: no administrator
# (an existing one is disabled on start). Sign in on the usual login page.
# TEACHERBOX_IDENTITY_ADMIN_LOGIN=admin
# TEACHERBOX_IDENTITY_ADMIN_PASSWORD=

# --- Security -----------------------------------------------------------------
# HMAC secret for access tokens, at least 32 characters.
# Empty: a random key is generated on first start and kept in the data volume (/data/keys).
# TEACHERBOX_SECURITY_JWT_SECRET=

# Restoring from the interface ends the application so that the container starts it again and the
# backup is applied (true in the Docker image; false: restart the portal by hand).
# TEACHERBOX_BACKUP_RESTART=true
# To restore by hand: put a backup .zip into /data/restore/ and restart (see docs/operations.md).

# --- Resources and logs --------------------------------------------------------
# Container limits (docker compose). The JVM uses 75% of the memory limit.
# TEACHERBOX_MEMORY_LIMIT=1g
# TEACHERBOX_CPU_LIMIT=2
# JSON logs for log collectors (ecs, logstash or gelf); plain text when not set.
# LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs

# --- JVM ------------------------------------------------------------------------
# Add -XX:AOTMode=off to start without the AOT cache built into the image (a slower start).
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError

# ---------------------------------------------------------------------------
# Log files (JSON, /data/logs) for the administrator's log search
# ---------------------------------------------------------------------------
# LOGGING_LOGBACK_ROLLINGPOLICY_MAX_FILE_SIZE=10MB
# LOGGING_LOGBACK_ROLLINGPOLICY_TOTAL_SIZE_CAP=100MB
# LOGGING_LOGBACK_ROLLINGPOLICY_MAX_HISTORY=30
