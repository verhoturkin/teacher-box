#!/usr/bin/env bash
#
# Runs the verification of every part touched by the commit (AGENTS.md §8).
# Enable once per clone:  git config core.hooksPath .githooks
#
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

backend=false
frontend=false
docker=false
e2e=false
docs=false

while IFS= read -r file; do
    case "$file" in
        backend/*) backend=true ;;
        frontend/*) frontend=true ;;
        docker/* | compose.yaml | compose.*.yaml | .dockerignore | .env.example | scripts/install.sh | scripts/teacherbox | scripts/agent-setup.sh) docker=true ;;
        e2e/*) e2e=true ;;
        *.md | scripts/check-wiki.sh | scripts/check-agents.sh | scripts/verify.sh | .claude/* | .agents/* | .codex/*) docs=true ;;
    esac
    # Every script is shellchecked by the installer step of the docker part, whatever else it belongs to.
    case "$file" in
        scripts/*.sh) docker=true ;;
    esac
# --no-renames: a moved file names both its old and its new part; no --diff-filter: type changes count too.
done < <(git diff --cached --name-only --no-renames)

# Each part is checked on exactly the content of the commit (the index git hands to this hook, see
# GIT_INDEX_FILE): skipped when a stamp of that very content exists, run in place when the working tree
# equals the index, otherwise run on an export of the index (scripts/verify.sh, "staged").
for part in docs backend frontend docker e2e; do
    if [ "${!part}" = true ]; then
        "$ROOT/scripts/verify.sh" staged "$part"
    fi
done
